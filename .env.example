# Copie para .env e preencha com seus valores. NÃO commite .env (já está no .gitignore).
# Uso: cp .env.example .env && edite .env

# LiveKit Cloud (cloud.livekit.io) — use para áudio estável sem túnel 7880
# LIVEKIT_URL ou LIVEKIT_WS_URL (a API aceita os dois)
LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud
LIVEKIT_API_KEY=sua_api_key
LIVEKIT_API_SECRET=sua_api_secret

# Auth (obrigatório)
AUTH_JWT_SECRET=segredo_longo_e_aleatorio_para_jwt
